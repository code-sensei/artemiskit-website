---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';
import '../../styles/evals.css';
import { benchmarks, models, results, pct } from '../../lib/evals';

const faq = [
  { question: 'What is an ArtemisKit benchmark?', answer: 'A versioned set of scenarios that represent one kind of real work, such as reviewing an AML alert or triaging a security alert, with deterministic pass and fail checks for every case.' },
  { question: 'What does “draft, not yet reviewed” mean?', answer: 'The pack uses a synthetic rulebook and synthetic data and has not yet been reviewed by a qualified domain expert. Results are valid measurements of the declared checks, but the rulebook may not match any real organisation.' },
  { question: 'Can I run a benchmark myself?', answer: 'The compliance-workflow packs are open source in the ArtemisKit repository. The regression pack is available on request. Each runs with the ArtemisKit CLI against any supported provider.' },
];
const description = 'Versioned ArtemisKit benchmarks for real AI workflows: what each one tests, how it is graded, its review status and the models evaluated on it.';
---
<Layout title="Benchmarks: Versioned Scenario Sets — ArtemisKit" description={description} faq={faq}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Benchmarks', url: '/benchmarks/' }]}>
  <section class="ak-ev-head"><div class="ak-wrap">
    <nav class="ak-ev-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Benchmarks</span></nav>
    <h1>Benchmarks built from real work</h1>
    <p class="ak-answer">An ArtemisKit benchmark is a versioned set of scenarios drawn from one kind of real work, such as
      reviewing a suspicious transaction or triaging a security alert. Every case has deterministic checks, so a result
      points at a concrete output you can inspect. Each benchmark states what it tests, how it is graded and how far it has been reviewed.</p>
  </div></section>
  <div class="ak-wrap">
    <section class="ak-ev-section" aria-labelledby="all">
      <header><div><h2 id="all">All benchmarks</h2><p>{benchmarks.length} benchmarks with published results.</p></div></header>
      <div class="ak-cards">
        {benchmarks.map((b) => {
          const rows = results.filter((r) => r.benchmark === b.id && r.condition === 'thinking-on');
          const best = rows.reduce((top, r) => ((r.rate ?? -1) > (top?.rate ?? -1) ? r : top), rows[0]);
          return (
            <a class="ak-card-link" href={`/benchmarks/${b.id}/`}>
              <span class:list={['ak-status-pill', b.status]}>{b.status === 'stable' ? 'Stable' : 'Draft, not yet reviewed'}</span>
              <h3>{b.name}</h3>
              <p>{b.tests}</p>
              <div class="ak-meta-row">
                <span><b>{b.cases}</b> cases{b.packCases && b.packCases !== b.cases ? ` (of ${b.packCases})` : ''}</span>
                <span><b>{models.filter((m) => rows.some((r) => r.model === m.id)).length}</b> models</span>
                {best && <span>Top thinking-on pass rate <b>{pct(best.rate)}</b></span>}
              </div>
            </a>
          );
        })}
      </div>
    </section>
    <section class="ak-ev-section"><Faq items={faq} /></section>
  </div>
</Layout>
