---
import Layout from '../layouts/Layout.astro';import Faq from '../components/Faq.astro';
const faq=[{question:'What is ArtemisKit?',answer:'ArtemisKit is an open-source AI assurance toolkit by Vorbtech Innovative Solutions. It evaluates model responses and tool-using workflows against declared scenarios, rules and success criteria, with evidence and limitations available for review.'},{question:'Can I use it without hiring VIS?',answer:'Yes. The toolkit is Apache-2.0 licensed. Install it, inspect the source and run it in your own environment. Model providers may charge for inference; VIS-led assessments are a separate service.'},{question:'Does a passing evaluation certify compliance or safety?',answer:'No. A passing check applies to the scenario, configuration and evidence tested. ArtemisKit supports technical review; it does not provide legal certification, guarantee safety or replace domain judgment.'},{question:'What happens when a measurement is invalid or unavailable?',answer:'Workflow reports retain invalid and unavailable measurements separately from eligible passed and failed task outcomes. Missing evidence is visible; it is not converted into a passing result.'},{question:'Can it test agents that use tools?',answer:'Yes. Declared agent workflows use bounded tool permissions, simulated or disposable Docker environments, independent outcome checks, recovery controls and saved evidence. Read the workflow documentation for requirements and limits.'}];
const caps=[['Quality evaluation','Check what the model said against explicit expectations. Keep useful edge cases in reviewable YAML.','/docs/concepts/evaluators/','Explore evaluators'],['Security red teaming','Probe prompt injection, unsafe responses and policy boundaries in an authorised test scope.','/docs/cli/commands/redteam/','Explore red teaming'],['Operational testing','Measure latency and behaviour under load, with concurrency and workload under your control.','/docs/cli/commands/stress/','Explore stress testing'],['Agent workflows','Declare tools, permissions and budgets. Check the outcome independently of the agent’s own account.','/docs/workflows/contract/','Explore agent workflows'],['Evidence & reports','Turn saved workflow records into technical or executive reports. Keep gaps and uncertainty visible.','/docs/workflows/reports/','Explore reporting'],['Regression checks','Keep scenarios alongside your code. Review changed behaviour in CI before a change reaches users.','/docs/cli/ci-cd/','Explore CI integration']];
---
<Layout title="ArtemisKit — Open-source AI assurance by Vorbtech" description="Test AI against the work it actually needs to do. Open-source evaluation, red teaming, controlled agent workflows and inspectable evidence by Vorbtech Innovative Solutions." faq={faq}>
<section class="ak-hero ak-wrap"><div class="ak-hero-top"><div class="ak-kicker"><span class="ak-dot"></span>Open source by Vorbtech Innovative Solutions</div><a class="ak-textlink" href="https://github.com/code-sensei/artemiskit/releases/tag/v0.6.4">New: offline workflow assessment reports ↗</a></div><div class="ak-hero-grid"><div class="ak-hero-copy ak-reveal"><h1>Your AI has a job.<br/>Test it for<br/><em>that job.</em></h1><p>Go beyond a good-looking answer. Test models and agents against real workflows, clear rules and outcomes you can inspect.</p><div class="ak-actions"><a class="ak-btn" href="/docs/getting-started/">Start testing <span aria-hidden="true">↗</span></a><a class="ak-btn outline" href="/apply/">Request an assessment <span aria-hidden="true">→</span></a></div><div class="ak-install"><code>npm install -g @artemiskit/cli</code><button type="button" id="copy-install" aria-label="Copy installation command">Copy</button><span id="copy-status" class="sr-only" aria-live="polite"></span></div><p style="font-size:11px;margin-top:10px;color:var(--ak-muted)">Apache-2.0 · Runs in your environment · CLI requires Bun</p></div><div class="ak-evidence-wrap ak-reveal" style="animation-delay:.12s"><div class="ak-gate" aria-hidden="true"></div><section class="ak-evidence" aria-label="Illustrative assessment scope"><div class="ak-evidence-head"><span>SCENARIO / REQUIREMENT / EVIDENCE</span><span class="ak-example-badge">Example</span></div><div class="ak-tabs" role="tablist" aria-label="Example workflows"><button type="button" role="tab" id="tab-privacy" aria-controls="panel-privacy" aria-selected="true" tabindex="0" data-example="privacy">Privacy</button><button type="button" role="tab" id="tab-authority" aria-controls="panel-authority" aria-selected="false" tabindex="-1" data-example="authority">Tool authority</button><button type="button" role="tab" id="tab-recovery" aria-controls="panel-recovery" aria-selected="false" tabindex="-1" data-example="recovery">Recovery</button></div>
<div id="panel-privacy" class="ak-evidence-body" role="tabpanel" aria-labelledby="tab-privacy"><h2>A refund request.<br/>A boundary worth checking.</h2><dl><dt>Workflow</dt><dd>Customer support / disputed payment</dd><dt>Requirement</dt><dd>Escalate the dispute. Do not disclose another customer’s account data.</dd><dt>Evidence</dt><dd>Response checks, tool actions and independently observed outcome.</dd><dt>Limitations</dt><dd>Synthetic data. No production access.</dd></dl><div class="ak-contract"><span>Question to test</span><br/>Does the assistant follow the rule<br/>when the user pushes back?</div></div>
<div id="panel-authority" class="ak-evidence-body" role="tabpanel" aria-labelledby="tab-authority" hidden><h2>The tool exists.<br/>Is the agent allowed to use it?</h2><dl><dt>Workflow</dt><dd>Operations / approval handoff</dd><dt>Requirement</dt><dd>Prepare a decision. Request approval before taking the restricted action.</dd><dt>Evidence</dt><dd>Tool calls, permission decisions and resulting workflow state.</dd><dt>Limitations</dt><dd>Declared tools only. Simulated environment.</dd></dl><div class="ak-contract"><span>Question to test</span><br/>Does the agent stay inside its authority<br/>when a faster shortcut is available?</div></div>
<div id="panel-recovery" class="ak-evidence-body" role="tabpanel" aria-labelledby="tab-recovery" hidden><h2>A tool timed out.<br/>What happens next?</h2><dl><dt>Workflow</dt><dd>Document review / interrupted handoff</dd><dt>Requirement</dt><dd>Respect retry limits and preserve the workflow’s permission boundary.</dd><dt>Evidence</dt><dd>Fault records, retry decisions and independently checked final state.</dd><dt>Limitations</dt><dd>Declared faults. Bounded recovery scope.</dd></dl><div class="ak-contract"><span>Question to test</span><br/>Can the workflow recover without<br/>repeating a restricted action?</div></div><div class="ak-evidence-foot">Illustrative scope, not a measured result.<br/>No test runs or model calls occur on this page.</div></section></div></div></section>
<div class="ak-provider-strip"><div class="ak-wrap ak-providers"><span>WORK WITH YOUR<br/>MODEL STACK</span><strong>OpenAI</strong><strong>Anthropic</strong><strong>Azure OpenAI</strong><strong>Ant Ling</strong><strong>Vercel AI SDK</strong><a class="ak-textlink" href="/docs/cli/providers/">Provider docs ↗</a></div></div>
<section class="ak-section ak-wrap" id="toolkit"><div class="ak-section-header"><div><div class="ak-kicker"><span class="ak-dot"></span>The toolkit</div><h2>Different questions.<br/>One place to test them.</h2></div><p>Define what matters for your system. Run a controlled test. Review the evidence before you decide what to ship.</p></div><div class="ak-capabilities">{caps.map((cap,i)=><article class="ak-capability"><span class="ak-num">0{i+1}</span><h3>{cap[0]}</h3><p>{cap[1]}</p><a href={cap[2]}>{cap[3]} ↗</a></article>)}</div></section>
<section class="ak-section ak-dark"><div class="ak-wrap"><div class="ak-section-header"><div><div class="ak-kicker"><span class="ak-dot"></span>Start with one useful check</div><h2>A test you can read.<br/>An outcome you can question.</h2></div><p>Keep the scenario close to your code. Start with a small check, then add the awkward cases your workflow actually encounters.</p></div><div class="ak-path"><div class="ak-steps"><div class="ak-step"><div><h3>Define the requirement</h3><p>Write the prompt or workflow, allowed actions and expected behaviour.</p></div></div><div class="ak-step"><div><h3>Run it in a controlled environment</h3><p>Choose the provider and configuration. Keep scope, permissions and budgets explicit.</p></div></div><div class="ak-step"><div><h3>Inspect what happened</h3><p>Review outcomes and evidence gaps. Turn useful findings into repeatable checks.</p></div></div><div class="ak-actions"><a class="ak-btn orange" href="/docs/getting-started/">Run your first evaluation ↗</a></div></div><div class="ak-code-window"><div class="ak-code-bar"><span>hello.yaml</span><span>YAML</span></div><pre><code><span class="key">name:</span> hello-test
<span class="key">provider:</span> openai
<span class="key">model:</span> gpt-4o

<span class="key">cases:</span>
  - <span class="key">id:</span> greeting
    <span class="key">prompt:</span> "Say hello"
    <span class="key">expected:</span>
      <span class="key">type:</span> contains
      <span class="key">values:</span> ["hello"]
      <span class="key">mode:</span> any

<span class="comment"># With Bun and your provider key configured:</span>
<span class="comment"># akit run hello.yaml</span></code></pre><div class="ak-code-footer">A minimal text check. See the docs for workflow outcomes and independent verification.</div></div></div></div></section>
<section class="ak-section ak-wrap"><div class="ak-section-header"><div><div class="ak-kicker"><span class="ak-dot"></span>Real work, explicit boundaries</div><h2>The workflow changes.<br/>The need for evidence stays.</h2></div><p>A support answer, a citizen request and an operational handoff have different failure costs. Your tests should reflect that.</p></div><div class="ak-sectors"><a class="ak-sector" href="/use-cases/public-sector/"><div><h3>Public sector</h3><p>Policy boundaries, citizen data and transparent escalation.</p></div><span aria-hidden="true">↗</span></a><a class="ak-sector" href="/use-cases/financial-services/"><div><h3>Financial services</h3><p>Approval limits, privacy and exception handling.</p></div><span aria-hidden="true">↗</span></a><a class="ak-sector" href="/use-cases/enterprise-operations/"><div><h3>Enterprise operations</h3><p>Approved sources, tool authority and human handoffs.</p></div><span aria-hidden="true">↗</span></a><a class="ak-sector" href="/use-cases/model-providers/"><div><h3>Model providers</h3><p>Scenario-specific capability and agent behaviour.</p></div><span aria-hidden="true">↗</span></a></div><a class="ak-textlink" style="display:inline-block;margin-top:24px" href="/use-cases/">Explore all use cases ↗</a></section>
<section class="ak-band"><div class="ak-wrap"><div><h2>Bring the workflow.<br/>Leave with evidence.</h2><p>Need a scoped assessment? Vorbtech helps define the tests, examine the findings and make the limitations clear.</p></div><a class="ak-btn" href="/apply/">Discuss an assessment ↗</a></div></section>
<section class="ak-section ak-wrap"><div class="ak-oss"><div><div class="ak-kicker"><span class="ak-dot"></span>Open by design</div><h2>Inspect it.<br/>Run it. Improve it.</h2><p>ArtemisKit is an Apache-2.0 open-source project by Vorbtech Innovative Solutions. Use the toolkit independently. Bring a bug, a scenario or a better way to test.</p></div><div class="ak-oss-links"><a href="https://github.com/code-sensei/artemiskit"><span>Explore the source</span><span>↗</span></a><a href="/community/"><span>Contribute to the project</span><span>↗</span></a><a href="/roadmap/"><span>See what is shipped and what is next</span><span>↗</span></a><a href="/about/"><span>Meet the project and its purpose</span><span>↗</span></a></div></div></section>
<section class="ak-section ak-wrap" style="padding-top:0"><Faq items={faq}/></section>
</Layout>
<script>
const copy=document.querySelector<HTMLButtonElement>('#copy-install');copy?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText('npm install -g @artemiskit/cli');copy.textContent='Copied';const status=document.querySelector('#copy-status');if(status)status.textContent='Installation command copied.';setTimeout(()=>{copy.textContent='Copy'},2000)}catch{copy.textContent='Select command';const status=document.querySelector('#copy-status');if(status)status.textContent='Clipboard unavailable. Select and copy the installation command.';}});
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[data-example]'));
function selectTab(tab:HTMLButtonElement){tabs.forEach(t=>{const selected=t===tab;t.setAttribute('aria-selected',String(selected));t.tabIndex=selected?0:-1;const panel=document.getElementById(`panel-${t.dataset.example}`);if(panel)panel.hidden=!selected})}
tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>selectTab(tab));tab.addEventListener('keydown',e=>{let next=index;if(e.key==='ArrowRight')next=(index+1)%tabs.length;else if(e.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();selectTab(tabs[next]);tabs[next].focus()})});
</script>
