---
import BaseHead from '../components/BaseHead.astro';import Header from '../components/Header.astro';import Footer from '../components/Footer.astro';import '../styles/global.css';import '../styles/identity.css';
interface Props{title:string;description:string;image?:string;hideHeader?:boolean;hideFooter?:boolean;noindex?:boolean;faq?:Array<{question:string;answer:string}>;breadcrumbs?:Array<{name:string;url:string}>}
const{title,description,image,hideHeader=false,hideFooter=false,noindex=false,faq=[],breadcrumbs=[]}=Astro.props;
---
<!doctype html><html lang="en"><head><BaseHead title={title} description={description} image={image} noindex={noindex} faq={faq} breadcrumbs={breadcrumbs}/></head><body class:list={["ak-site",{"ak-legacy": Astro.url.pathname.startsWith("/blog") || Astro.url.pathname === "/sitemap/"}]}><a href="#main-content" class="ak-skip">Skip to content</a>{!hideHeader&&<Header/>}<main id="main-content"><slot/></main>{!hideFooter&&<Footer/>}</body></html>
