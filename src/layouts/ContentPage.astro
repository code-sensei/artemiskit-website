---
import Layout from './Layout.astro';import Faq from '../components/Faq.astro';
interface Props{title:string;description:string;seoTitle?:string;eyebrow?:string;faq?:Array<{question:string;answer:string}>}
const{title,description,seoTitle,eyebrow='ArtemisKit',faq=[]}=Astro.props;
---
<Layout title={`${seoTitle || title} — ArtemisKit`} description={description} faq={faq}><section class="ak-page-head"><div class="ak-wrap"><div class="ak-kicker"><span class="ak-dot"></span>{eyebrow}</div><h1>{title}</h1><p>{description}</p></div></section><div class="ak-wrap"><article class="ak-prose"><slot/>{faq.length>0&&<div style="margin-top:60px"><Faq items={faq}/></div>}</article></div></Layout>
