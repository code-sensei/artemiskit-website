---
interface Props {title:string;description:string;image?:string;noindex?:boolean;faq?:Array<{question:string;answer:string}>;breadcrumbs?:Array<{name:string;url:string}>}
const {title,description,image='/og-image.png',noindex=false,faq=[],breadcrumbs=[]}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);const imageURL=new URL(image,Astro.site);
const schema:any[]=[{'@context':'https://schema.org','@type':'WebSite',name:'ArtemisKit',url:Astro.site?.href,publisher:{'@type':'Organization',name:'Vorbtech Innovative Solutions',url:'https://www.vorbtech.com.ng/'} }];
if(Astro.url.pathname==='/')schema.push({'@context':'https://schema.org','@type':'SoftwareSourceCode',name:'ArtemisKit',description,codeRepository:'https://github.com/code-sensei/artemiskit',license:'https://www.apache.org/licenses/LICENSE-2.0',programmingLanguage:'TypeScript',author:{'@type':'Organization',name:'Vorbtech Innovative Solutions'}});
if(faq.length)schema.push({'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))});
if(breadcrumbs.length)schema.push({'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:breadcrumbs.map((b,i)=>({'@type':'ListItem',position:i+1,name:b.name,item:new URL(b.url,Astro.site).href}))});
---
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="generator" content={Astro.generator}/><link rel="icon" type="image/png" href="/favicon-32.png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex&&<meta name="robots" content="noindex,nofollow"/>}<meta property="og:type" content="website"/><meta property="og:site_name" content="ArtemisKit"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={imageURL}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={imageURL}/><meta name="theme-color" content="#F5F3EC"/>{schema.map(s=><script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g,'\\u003c')}/>)}
