---
import ThemeSelect from './ThemeSelect.astro';
const links = [{label:'Toolkit',url:'/toolkit/'},{label:'Documentation',url:'/docs/'},{label:'Use cases',url:'/use-cases/'},{label:'About',url:'/about/'}];
---
<header class="ak-header"><div class="ak-wrap ak-nav">
<a class="ak-logo" href="/" aria-label="ArtemisKit home"><img class="ak-logo-on-light" src="/artemiskit-wordmark-dark.webp" width="797" height="174" alt="ArtemisKit" /><img class="ak-logo-on-dark" src="/artemiskit-wordmark-light.webp" width="797" height="174" alt="ArtemisKit" /></a>
<nav class="ak-links" id="primary-navigation" aria-label="Main navigation">{links.map(link=><a href={link.url} aria-current={Astro.url.pathname.startsWith(link.url)?'page':undefined}>{link.label}</a>)}</nav>
<div class="ak-nav-end"><ThemeSelect/><a class="ak-github" href="https://github.com/code-sensei/artemiskit">GitHub ↗</a><a class="ak-btn" href="/docs/getting-started/">Get started <span aria-hidden="true">↗</span></a><button class="ak-menu" aria-expanded="false" aria-controls="primary-navigation" type="button">Menu</button></div>
</div></header>
<script>
const menu=document.querySelector<HTMLButtonElement>('.ak-menu');const nav=document.querySelector<HTMLElement>('#primary-navigation');
menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));if(nav)nav.dataset.open=String(open)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu?.getAttribute('aria-expanded')==='true'){menu.setAttribute('aria-expanded','false');if(nav)nav.dataset.open='false';menu.focus()}});
</script>
