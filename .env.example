# Server only. Reuse VIS's existing verified Resend account configuration.
# Set in Vercel's server environment or the VPS service environment; never PUBLIC_*.
RESEND_API_KEY=
EMAIL_FROM=artemiskit@vorbtech.com.ng
# The server applies the display name "ArtemisKit by Vorbtech" to this mailbox.
ADMIN_EMAIL=admin@vorbtech.com.ng
# Team notifications and requester acknowledgements always BCC the maintainer in server code.
# Canonical website origin for email links (also the server default).
# Mailboxes remain on the VIS VPS; the website is hosted on Vercel.
EMAIL_SITE_URL=https://artemiskit.vorbtech.com.ng
# Optional public HTTPS logo override. The default official PNG is hosted on artemiskit.vercel.app.
# A protected Preview URL will not load in recipients' email image proxies.
EMAIL_LOGO_URL=

# Optional independent token-signing secret. Defaults to a context-separated HMAC
# using the Resend key. Set a strong value in the server secret store if preferred.
ASSESSMENT_SIGNING_SECRET=
ASSESSMENT_ALLOWED_ORIGINS=https://artemiskit.vorbtech.com.ng
ASSESSMENT_PORT=8787
# Enable only behind the supplied loopback reverse-proxy configuration.
ASSESSMENT_TRUST_PROXY=loopback
